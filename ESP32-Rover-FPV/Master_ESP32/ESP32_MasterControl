void setup() {
  Serial.begin(115200);

  // Init Motors
  pinMode(enA, OUTPUT); pinMode(in1, OUTPUT); pinMode(in2, OUTPUT);
  pinMode(enB, OUTPUT); pinMode(in3, OUTPUT); pinMode(in4, OUTPUT);
  stopMotors();

  // Init Sensors
  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);
  pinMode(PIR_PIN, INPUT);

  // Setup Wi-Fi Access Point
  Serial.println("\nConfiguring Access Point...");
  WiFi.softAP(ssid, password);
  Serial.print("Main Dashboard IP: ");
  Serial.println(WiFi.softAPIP()); 

  // Server Routes
  server.on("/", []() { server.send_P(200, "text/html", HTML_PAGE); });
  
  // Motor Routes
  server.on("/w", []() { moveForward(); server.send(200, "text/plain", "W"); });
  server.on("/s", []() { moveBackward(); server.send(200, "text/plain", "S"); });
  server.on("/a", []() { tankTurnLeft(); server.send(200, "text/plain", "A"); });
  server.on("/d", []() { tankTurnRight(); server.send(200, "text/plain", "D"); });
  server.on("/stop", []() { stopMotors(); server.send(200, "text/plain", "STOP"); });

  // JSON Sensor Route
  server.on("/sensors", handleSensors);

  server.begin();
  Serial.println("Dashboard Server Started!");
}

void loop() {
  server.handleClient();
}

// --- SENSOR FUNCTION ---
void handleSensors() {
  // 1. Read Ultrasonic Distance
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);
  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);
  
  long duration = pulseIn(ECHO_PIN, HIGH, 30000); // 30ms timeout
  int distance = (duration == 0) ? -1 : duration * 0.034 / 2;

  // 2. Read PIR Motion
  bool motionDetected = digitalRead(PIR_PIN);

  // 3. Build JSON response
  String json = "{";
  json += "\"distance\":" + String(distance) + ",";
  json += "\"motion\":" + String(motionDetected ? "true" : "false");
  json += "}";

  server.send(200, "application/json", json);
}

// --- MOTOR FUNCTIONS ---
void moveForward() {
  digitalWrite(in1, LOW);  digitalWrite(in2, HIGH); analogWrite(enA, 220);
  digitalWrite(in3, LOW);  digitalWrite(in4, HIGH); analogWrite(enB, 220);
}
void moveBackward() {
  digitalWrite(in1, HIGH); digitalWrite(in2, LOW);  analogWrite(enA, 220);
  digitalWrite(in3, HIGH); digitalWrite(in4, LOW);  analogWrite(enB, 220);
}
void tankTurnLeft() {
  digitalWrite(in1, HIGH); digitalWrite(in2, LOW);  analogWrite(enA, 220); 
  digitalWrite(in3, LOW);  digitalWrite(in4, HIGH); analogWrite(enB, 220); 
}
void tankTurnRight() {
  digitalWrite(in1, LOW);  digitalWrite(in2, HIGH); analogWrite(enA, 220); 
  digitalWrite(in3, HIGH); digitalWrite(in4, LOW);  analogWrite(enB, 220); 
}
void stopMotors() {
  analogWrite(enA, 0);   analogWrite(enB, 0);
  digitalWrite(in1, LOW); digitalWrite(in2, LOW);
  digitalWrite(in3, LOW); digitalWrite(in4, LOW);
}
